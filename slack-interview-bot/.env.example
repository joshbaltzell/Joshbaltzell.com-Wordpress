# Database (docker-compose overrides these — only needed for local non-Docker dev)
DATABASE_URL=postgresql://user:password@localhost:5432/interview_bot

# Redis (docker-compose overrides these — only needed for local non-Docker dev)
REDIS_URL=redis://localhost:6379

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token  # Socket Mode (development)

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Auth
NEXTAUTH_SECRET=generate-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Cron (optional — protects cron endpoints from unauthorized access)
CRON_SECRET=generate-a-random-secret-for-cron

# Interview defaults
DEFAULT_MAX_ROUNDS=10
DEFAULT_NUDGE_HOURS=48
DEFAULT_APPROVAL_MODE=auto  # auto | editor_approves_all | full_auto
