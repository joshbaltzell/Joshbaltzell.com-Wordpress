			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--5)",
			"padding": {
				"top": "0",
				"right": "var(--wp--custom--layout--gutter)",
				"bottom": "0",
				"left": "var(--wp--custom--layout--gutter)"
			}
		},
