					"lineHeight": "1.14",
					"fontWeight": "700",
					"letterSpacing": "-0.012em"
				}
			},
			"link": {
				"color": {
					"text": "inherit"
				},
				"typography": {
					"textDecoration": "underline"
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--ui)",
					"lineHeight": "1.34",
					"fontWeight": "700",
					"letterSpacing": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--on-primary)"
				},
				"border": {
					"width": "var(--wp--custom--outline--part)",
					"style": "solid",
					"color": "var(--wp--preset--color--ink)",
					"radius": "var(--wp--custom--radius--md)"
				},
				"shadow": "var(--wp--preset--shadow--edge-rest)",
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--2)",
						"bottom": "var(--wp--preset--spacing--2)",
						"left": "var(--wp--preset--spacing--4)",
						"right": "var(--wp--preset--spacing--4)"
					}
				},
				":hover": {
					"shadow": "var(--wp--preset--shadow--edge-lift)"
				},
				":active": {
					"shadow": "var(--wp--preset--shadow--edge-press)"
				},
				":focus": {
					"shadow": "var(--wp--preset--shadow--focus-ring)"
				}
			},
			"caption": {
