					"background": "var(--wp--preset--color--part-straw)",
					"text": "var(--wp--preset--color--on-straw)"
				},
				"border": {
					"width": "var(--wp--custom--outline--part)",
					"style": "solid",
					"color": "var(--wp--preset--color--ink)",
					"radius": "var(--wp--custom--radius--sm)"
				},
				"shadow": "var(--wp--preset--shadow--drop)"
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--title)",
					"lineHeight": "1.06",
					"fontWeight": "800",
					"letterSpacing": "-0.02em"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--lead)",
					"fontWeight": "700"
				}
			}
		}
	}
}
